APP_NAME="Freddy Motos"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# En producción (Render): DB_CONNECTION=pgsql
# DB_URL = connection string POOLED de Neon (el host tiene "-pooler" en el nombre).
# La usa la app en cada request; es la rápida.
# DB_URL_MIGRATE = connection string DIRECTA de Neon (sin "-pooler"). Se usa
# solo al migrar (start.sh), porque las migraciones no andan bien con pooling.
# DB_URL=
# DB_URL_MIGRATE=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=mailjet
# El remitente tiene que estar verificado en el panel del proveedor de email elegido.
MAIL_FROM_ADDRESS="tu-email-verificado@ejemplo.com"
MAIL_FROM_NAME="${APP_NAME}"

MAILJET_API_KEY=
MAILJET_API_SECRET=

# Brevo y Mailgun quedan como alternativas ya soportadas por la app.
BREVO_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net

# Almacenamiento de imágenes (logo, productos, categorías, taller, fotos del negocio).
# En local se deja vacío (usa el disco del servidor). En producción (Render) se
# completa con las credenciales de Cloudflare R2 y se agrega FILESYSTEM_PUBLIC_DRIVER=s3.
# FILESYSTEM_PUBLIC_DRIVER=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
# URL pública del bucket de R2 (la que muestra Cloudflare al activar "Public access").
AWS_URL=

VITE_APP_NAME="${APP_NAME}"

# Mercado Pago (usar credencial de PRUEBA: TEST-...)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_CURRENCY=ARS
